# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=dev
LOG_LEVEL=INFO
# Optional error tracking (sentry.io or self-hosted). Empty = disabled.
SENTRY_DSN=

# Telegram
BOT_TOKEN=123456789:replace-with-botfather-token
# Comma-separated Telegram user IDs with full admin rights.
SUPERADMIN_IDS=

# Infra (defaults match docker-compose.yml when the app runs on the host)
DATABASE_URL=postgresql+asyncpg://xyz:xyz@localhost:5432/xyz
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=xyz

# Backups (the `backup` service): daily dump time in UTC, weekday of the restore test (1=Mon … 7=Sun)
BACKUP_AT=03:15
BACKUP_CHECK_WEEKDAY=7
BACKUP_KEEP_DAYS=14

# Tests (separate database!)
TEST_DATABASE_URL=postgresql+asyncpg://xyz:xyz@localhost:5432/xyz_test
