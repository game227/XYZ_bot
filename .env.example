# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Telegram
BOT_TOKEN=123456789:replace-with-botfather-token
# Comma-separated Telegram user IDs with full admin rights.
SUPERADMIN_IDS=

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Infra (defaults match docker-compose.yml when the app runs on the host)
DATABASE_URL=postgresql+asyncpg://xyz:xyz@localhost:5432/xyz
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=xyz

# Public HTTPS URL of the web service (Mini App + video player).
# Dev: cloudflared tunnel --url http://localhost:8080
WEB_BASE_URL=https://example.trycloudflare.com

# S3-compatible storage (MinIO in dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=xyz-media
S3_REGION=us-east-1

# Tests (separate database!)
TEST_DATABASE_URL=postgresql+asyncpg://xyz:xyz@localhost:5432/xyz_test
